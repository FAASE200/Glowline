<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas sin dependencias externas: se ejecutan con `dotnet run` y
    devuelven código de salida distinto de 0 si alguna falla. Así funcionan
    igual en local, sin conexión a NuGet, y en GitHub Actions.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LyricGlow.Core\LyricGlow.Core.csproj" />
  </ItemGroup>

</Project>
