<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests with no external dependencies: run them with `dotnet run`; the
    exit code is non-zero if any test fails. This works the same locally
    (no NuGet access needed) and on GitHub Actions.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LyricGlow.Core\LyricGlow.Core.csproj" />
  </ItemGroup>

</Project>
