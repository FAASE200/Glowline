<Window x:Class="Glowline.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glowline"
        xmlns:controls="clr-namespace:Glowline.Controls"
        xmlns:loc="clr-namespace:Glowline.Localization"
        xmlns:rd="clr-namespace:Glowline.Rendering"
        Title="Glowline" MinWidth="960" MinHeight="680"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="True"
        Background="#000000" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="999" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hl" CornerRadius="999" Background="#FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <CornerRadius x:Key="DesignTransportCorner">999</CornerRadius>
        <Style x:Key="DesignTransport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="{DynamicResource DesignTransportCorner}"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hl" CornerRadius="{DynamicResource DesignTransportCorner}"
                                    Background="#FFFFFF" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.16"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostCircle" TargetType="Button" BasedOn="{StaticResource DesignTransport}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="LightCircle" TargetType="Button" BasedOn="{StaticResource GhostCircle}">
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="Foreground" Value="#17171A"/>
        </Style>
        <Style x:Key="TransportArrow" TargetType="Path">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.1"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>
        <Style x:Key="ChromeCircle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>

        <SolidColorBrush x:Key="SettingsPaper" Color="#0F1219"/>
        <SolidColorBrush x:Key="SettingsInk" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SettingsMuted" Color="#B2B2BB"/>
        <SolidColorBrush x:Key="SettingsLine" Color="#23FFFFFF"/>
        <SolidColorBrush x:Key="SettingsAccent" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SettingsTrack" Color="#333946"/>
        <SolidColorBrush x:Key="SettingsThumb" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SettingsThumbStroke" Color="#585F6C"/>
        <SolidColorBrush x:Key="SettingsHover" Color="#181C25"/>
        <SolidColorBrush x:Key="SettingsScrollThumb" Color="#697180"/>
        <SolidColorBrush x:Key="SettingsScrollThumbHover" Color="#9099AA"/>
        <SolidColorBrush x:Key="SettingsBorder" Color="#23FFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassSurface" Color="#C20A0D16"/>
        <SolidColorBrush x:Key="SettingsGlassBorder" Color="#23FFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassFill" Color="#0BFFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassFillHover" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassFillActive" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SettingsOverlayHover" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsOnAccent" Color="#080A0F"/>

        <Style x:Key="SettingsSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <Style x:Key="SettingsSectionNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/>
            <Setter Property="Width" Value="24"/>
        </Style>

        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SettingsLine}"/>
            <Setter Property="Margin" Value="0,18,0,14"/>
        </Style>

        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SettingsTrack}"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource SettingsThumb}"
                                     Stroke="{DynamicResource SettingsThumbStroke}"
                                     StrokeThickness="1" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccent}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="1">
                            <Border x:Name="Idle" CornerRadius="8" Background="{DynamicResource SettingsGlassFill}"
                                    Opacity="0"/>
                            <Border x:Name="Active" CornerRadius="8" Background="{DynamicResource SettingsGlassFillActive}"
                                    BorderBrush="{DynamicResource SettingsGlassBorder}" BorderThickness="1" Opacity="0"/>
                            <ContentPresenter Margin="11,5,11,6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Idle" Property="Opacity" Value="0"/>
                                <Setter TargetName="Active" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Idle" Property="Opacity" Value="1"/>
                                <Setter TargetName="Idle" Property="Background" Value="{DynamicResource SettingsGlassFillHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Active" Property="Opacity" Value="1"/>
                                <Setter TargetName="Idle" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSegmentBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsGlassFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsGlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="3"/>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="2" Background="{DynamicResource SettingsLine}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Background="{DynamicResource SettingsAccent}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource SettingsAccent}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="2" Background="Transparent" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SettingsGlassFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsGlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="Hl" CornerRadius="9" Background="{DynamicResource SettingsOverlayHover}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.05"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.10"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryAction" TargetType="Button" BasedOn="{StaticResource SettingsAction}">
            <Setter Property="Background" Value="{DynamicResource SettingsAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingsIconAction" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="2" Background="{DynamicResource SettingsHover}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsInk}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="SettingsScrollThumbTemplate" TargetType="Thumb">
            <Border x:Name="Bd" Background="{DynamicResource SettingsScrollThumb}" CornerRadius="3" Margin="2"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SettingsScrollThumbHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource SettingsScrollThumbTemplate}" MinHeight="28"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#000000">
        <rd:ParticleField x:Name="DesignParticles" Panel.ZIndex="1" IsHitTestVisible="False"/>

        <Grid x:Name="DarkLayout">
            <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.55"
                   RenderOptions.BitmapScalingMode="LowQuality" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="BackdropScale"/>
                </Image.RenderTransform>
            </Image>
            <Border x:Name="DarkBackdropTint">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.55,1">
                        <GradientStop Color="#B3000000" Offset="0"/>
                        <GradientStop Color="#80000000" Offset="0.45"/>
                        <GradientStop Color="#E6000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="DarkContentGrid" Margin="64,48,64,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="DarkInfoPanel" Width="380" VerticalAlignment="Center">
                    <Border x:Name="DarkCoverBorder" CornerRadius="18" Width="380" Height="380">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="70" ShadowDepth="20" Opacity="0.55" Color="Black" RenderingBias="Performance"/>
                        </Border.Effect>
                        <Grid x:Name="DarkCoverContent">
                            <Border CornerRadius="18" Background="#17171B"/>
                            <TextBlock x:Name="CoverPlaceholder" Text="♪" FontSize="72" Foreground="#22FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverA" Stretch="UniformToFill"/>
                            <Image x:Name="CoverB" Stretch="UniformToFill" Opacity="0"/>
                            <MediaElement x:Name="AnimatedCoverDark" Stretch="UniformToFill" Opacity="0"
                                          Panel.ZIndex="2"
                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          IsMuted="True" Volume="0"
                                          MediaOpened="AnimatedCover_MediaOpened"
                                          MediaEnded="AnimatedCover_MediaEnded"
                                          MediaFailed="AnimatedCover_MediaFailed"/>
                            <Border x:Name="DarkCoverMask" BorderThickness="0" BorderBrush="Transparent"
                                    Panel.ZIndex="3" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TitleText" Text="{loc:T NoPlayback}" FontSize="26" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI" TextWrapping="Wrap"
                               Margin="2,26,2,0" TextTrimming="CharacterEllipsis" MaxHeight="76"/>
                    <TextBlock x:Name="ArtistText" FontSize="17" Foreground="#B8FFFFFF" Margin="2,6,2,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlbumText" FontSize="13" Foreground="#66FFFFFF" Margin="2,4,2,0"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel x:Name="DarkTransport" Margin="0,22,0,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="DarkTransportShift"/>
                        </StackPanel.RenderTransform>
                        <StackPanel x:Name="DarkTransportButtons" Orientation="Horizontal">
                            <Button x:Name="PrevButton" Style="{StaticResource GhostCircle}">
                                <Path Style="{StaticResource TransportArrow}"
                                      Data="M 4,4.4 L 6.4,4.4 L 6.4,19.6 L 4,19.6 Z M 19.6,4.4 L 7.8,12 L 19.6,19.6 Z"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource GhostCircle}" Margin="10,0">
                                <controls:PlayPauseIcon x:Name="DarkPlayPauseIcon" Width="19" Height="19"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource GhostCircle}">
                                <Path Style="{StaticResource TransportArrow}"
                                      Data="M 20,4.4 L 17.6,4.4 L 17.6,19.6 L 20,19.6 Z M 4.4,4.4 L 16.2,12 L 4.4,19.6 Z"/>
                            </Button>
                        </StackPanel>

                        <Grid x:Name="DarkProgress" Margin="2,20,2,0" Width="376">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="ProgressTrack" Grid.Column="1" Height="3" CornerRadius="2"
                                    Background="#26FFFFFF" Margin="10,0" VerticalAlignment="Center">
                                <Border x:Name="ProgressFill" HorizontalAlignment="Stretch"
                                        CornerRadius="2" Background="#FFFFFFFF" RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ProgressFillScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="DurText" Grid.Column="2" Text="--:--" FontSize="11"
                                       Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="LyricsHost" Grid.Column="1" Margin="60,0,0,0">
                    <Canvas x:Name="LyricsCanvas" ClipToBounds="True">
                        <Canvas x:Name="LinesLayer">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="ScrollTransform"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                    <ScrollViewer x:Name="PlainScrollFull" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <TextBlock x:Name="PlainFullText" FontSize="20" LineHeight="30" Foreground="#DCFFFFFF"
                                   TextWrapping="Wrap" TextAlignment="Left"/>
                    </ScrollViewer>
                    <TextBlock x:Name="StatusMessage" Text="{loc:T NoPlayback}" FontSize="20" Foreground="#99FFFFFF"
                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed" MaxWidth="520"/>
                    <local:IntroDots x:Name="DarkIntroDots" HorizontalAlignment="Left">
                        <local:IntroDots.RenderTransform>
                            <TranslateTransform x:Name="DarkDotsShift"/>
                        </local:IntroDots.RenderTransform>
                    </local:IntroDots>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="LightLayout" Background="#FFFFFF" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Image x:Name="LightBackdropImage" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0"
                   IsHitTestVisible="False" RenderOptions.BitmapScalingMode="LowQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LightBackdropScale"/>
                </Image.RenderTransform>
            </Image>
            <Border x:Name="LightBackdropScrim" Grid.RowSpan="2" IsHitTestVisible="False"
                    Background="Transparent" Opacity="0"/>

            <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="24,18,24,0">
                <Border x:Name="LightCoverBorder" Width="360" Height="360" CornerRadius="20" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="55" ShadowDepth="16" Opacity="0.25" Color="Black" RenderingBias="Performance"/>
                    </Border.Effect>
                    <Grid x:Name="LightCoverContent">
                        <Border x:Name="LightCoverBack" CornerRadius="20" Background="#F1F1F3"/>
                        <Image x:Name="LightCoverA" Stretch="UniformToFill"/>
                        <Image x:Name="LightCoverB" Stretch="UniformToFill" Opacity="0"/>
                        <MediaElement x:Name="AnimatedCoverLight" Stretch="UniformToFill" Opacity="0"
                                      Panel.ZIndex="2"
                                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      IsMuted="True" Volume="0"
                                      MediaOpened="AnimatedCover_MediaOpened"
                                      MediaEnded="AnimatedCover_MediaEnded"
                                      MediaFailed="AnimatedCover_MediaFailed"/>
                        <Border x:Name="LightCoverMask" BorderThickness="1" BorderBrush="Transparent"
                                Panel.ZIndex="3" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="LightTitle" Text="{loc:T NoPlayback}" FontSize="24" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#101013"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="760" MaxHeight="74" TextTrimming="CharacterEllipsis" Margin="0,22,0,0"/>
                <TextBlock x:Name="LightArtist" FontSize="15" Foreground="#55555C"
                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="760" Margin="0,4,0,0"/>
                <TextBlock x:Name="LightAlbum" FontSize="12" Foreground="#8A8A90"
                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="760" Margin="0,2,0,0"/>

                <StackPanel x:Name="LightTransport" Margin="0,16,0,0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="LightTransportShift"/>
                    </StackPanel.RenderTransform>
                    <StackPanel x:Name="LightTransportButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="LightPrevButton" Style="{StaticResource LightCircle}">
                            <Path Style="{StaticResource TransportArrow}"
                                  Data="M 4,4.4 L 6.4,4.4 L 6.4,19.6 L 4,19.6 Z M 19.6,4.4 L 7.8,12 L 19.6,19.6 Z"/>
                        </Button>
                        <Button x:Name="LightPlayPauseButton" Style="{StaticResource LightCircle}" Margin="10,0">
                            <controls:PlayPauseIcon x:Name="LightPlayPauseIcon" Width="19" Height="19"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="LightNextButton" Style="{StaticResource LightCircle}">
                            <Path Style="{StaticResource TransportArrow}"
                                  Data="M 20,4.4 L 17.6,4.4 L 17.6,19.6 L 20,19.6 Z M 4.4,4.4 L 16.2,12 L 4.4,19.6 Z"/>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="LightProgress" Margin="0,14,0,0" Width="360">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LightPosText" Text="0:00" FontSize="11" Foreground="#8A8A90" VerticalAlignment="Center"/>
                        <Border x:Name="LightProgressTrack" Grid.Column="1" Height="3" CornerRadius="2"
                                Background="#14000000" Margin="10,0" VerticalAlignment="Center">
                            <Border x:Name="LightProgressFill" HorizontalAlignment="Stretch"
                                    CornerRadius="2" Background="#101013" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LightProgressFillScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="LightDurText" Grid.Column="2" Text="--:--" FontSize="11"
                                   Foreground="#8A8A90" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="LightSharedLyricsSlot" Grid.Row="1" Margin="60,8,60,26"/>
        </Grid>

        <Grid x:Name="ChromeLayer" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22">
                <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource ChromeCircle}"
                        FontFamily="Segoe UI Symbol" FontSize="17" ToolTip="{loc:T SettingsTooltip}"/>
                <Button x:Name="CloseButton" Content="✕" Style="{StaticResource ChromeCircle}"
                        Margin="10,0,0,0" ToolTip="{loc:T CloseGlowline}"/>
            </StackPanel>

            <Border x:Name="SettingsPanel" Width="400" Margin="0,74,22,22"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{DynamicResource SettingsGlassSurface}" BorderBrush="{DynamicResource SettingsGlassBorder}"
                    BorderThickness="1" CornerRadius="18" Visibility="Collapsed" Opacity="0" Panel.ZIndex="20"
                    TextElement.Foreground="{DynamicResource SettingsInk}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="70" ShadowDepth="18" Opacity="0.42" Color="Black" RenderingBias="Performance"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsPanelShift" Y="-8"/>
                </Border.RenderTransform>
                <Grid Margin="24,20,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:PulseLogo Width="32" Height="32" VerticalAlignment="Center"
                                            BarBrush="{DynamicResource SettingsInk}"
                                            AccentBrush="{DynamicResource SettingsAccent}"
                                            Margin="0,0,9,0"
                                            AutomationProperties.Name="Glowline"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{loc:T SettingsTitle}" FontSize="24" FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Text="{loc:T QuickSettingsSubtitle}" FontSize="11.5" Foreground="{DynamicResource SettingsMuted}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="SettingsCloseButton" Grid.Column="2"
                                Style="{StaticResource SettingsIconAction}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" ToolTip="{loc:T CloseSettings}">
                            <Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Margin="0,18,0,0"
                                  MaxHeight="610" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <Border Height="1" Background="{DynamicResource SettingsLine}" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="01" Style="{StaticResource SettingsSectionNumber}"/>
                                <TextBlock Text="{loc:T SettingsSectionPlayback}" Style="{StaticResource SettingsSection}"/>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:T AnimatedCoverShort}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:T AnimatedCoverShortSub}" FontSize="10.5"
                                               Foreground="{DynamicResource SettingsMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="SettingsAnimatedCheck" Grid.Column="1"
                                          Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{loc:T Designer.Artwork.Size}" FontSize="12"
                                       Foreground="{DynamicResource SettingsMuted}" Margin="0,14,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsCoverSizeSlider" Minimum="10" Maximum="60"
                                        Value="26" SmallChange="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource SettingsSlider}"
                                        ValueChanged="QuickCoverSize_Changed"/>
                                <TextBlock x:Name="SettingsCoverSizeText" Grid.Column="1" Text="26%"
                                           FontSize="12" Foreground="{DynamicResource SettingsMuted}" Width="42"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <TextBlock Text="{loc:T Designer.Artwork.AnimatedSize}" FontSize="12"
                                       Foreground="{DynamicResource SettingsMuted}" Margin="0,10,0,0"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SettingsAnimatedCoverSizeSlider" Minimum="10" Maximum="60"
                                        Value="26" SmallChange="1" IsSnapToTickEnabled="True"
                                        Style="{StaticResource SettingsSlider}"
                                        ValueChanged="QuickAnimatedCoverSize_Changed"/>
                                <TextBlock x:Name="SettingsAnimatedCoverSizeText" Grid.Column="1" Text="26%"
                                           FontSize="12" Foreground="{DynamicResource SettingsMuted}" Width="42"
                                           TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:T BeatGlow}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:T BeatGlowShortSub}" FontSize="10.5"
                                               Foreground="{DynamicResource SettingsMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="SettingsSoundSenseCheck" Grid.Column="1"
                                          Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SettingsLine}" Margin="0,20,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="02" Style="{StaticResource SettingsSectionNumber}"/>
                                <TextBlock Text="{loc:T SettingsSectionLyrics}" Style="{StaticResource SettingsSection}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:T Source}" FontSize="12" Foreground="{DynamicResource SettingsMuted}" Margin="0,14,0,0"/>
                            <Border Style="{StaticResource SettingsSegmentBar}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SettingsSourceLrcmux" Content="Lrcmux"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickSource"/>
                                    <RadioButton x:Name="SettingsSourceLyricsPlus" Content="LyricsPlus"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickSource"/>
                                    <RadioButton x:Name="SettingsSourceLrclib" Content="LRCLIB"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickSource"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{loc:T WordByWord}" FontSize="12" Foreground="{DynamicResource SettingsMuted}"
                                       Margin="0,16,0,0"/>
                            <Border Style="{StaticResource SettingsSegmentBar}" Margin="0,6,0,0">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="SettingsWordFade" Content="{loc:T Fade}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWordAnim"/>
                                    <RadioButton x:Name="SettingsWordSlide" Content="{loc:T Slide}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWordAnim"/>
                                    <RadioButton x:Name="SettingsWordZoom" Content="{loc:T Zoom}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWordAnim"/>
                                    <RadioButton x:Name="SettingsWordBounce" Content="{loc:T Bounce}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWordAnim"/>
                                </UniformGrid>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T Size}" FontSize="12" Foreground="{DynamicResource SettingsMuted}" VerticalAlignment="Center"/>
                                <Slider x:Name="SettingsFontSlider" Grid.Column="1" Minimum="70" Maximum="160"
                                        Value="100" Margin="12,0" Style="{StaticResource SettingsSlider}"/>
                                <TextBlock x:Name="SettingsFontText" Grid.Column="2" Text="100%"
                                           FontSize="12" Foreground="{DynamicResource SettingsMuted}" Width="42"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SettingsLine}" Margin="0,20,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="03" Style="{StaticResource SettingsSectionNumber}"/>
                                <TextBlock Text="{loc:T SettingsSectionWindow}" Style="{StaticResource SettingsSection}"/>
                            </StackPanel>

                            <TextBlock Text="{loc:T InterfaceTheme}" FontSize="12"
                                       Foreground="{DynamicResource SettingsMuted}" Margin="0,14,0,0"/>
                            <Border Style="{StaticResource SettingsSegmentBar}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SettingsThemeLightRadio" Content="{loc:T ThemeLight}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickInterfaceTheme"
                                                 Checked="QuickInterfaceTheme_Changed"/>
                                    <RadioButton x:Name="SettingsThemeDarkRadio" Content="{loc:T ThemeDark}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickInterfaceTheme"
                                                 Checked="QuickInterfaceTheme_Changed"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{loc:T InterfaceTranslucent}" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:T InterfaceTranslucentHint}" FontSize="10.5"
                                               Foreground="{DynamicResource SettingsMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="SettingsInterfaceGlassCheck" Grid.Column="1"
                                          Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource SettingsLine}" Margin="0,20,0,16"/>

                            <Border Style="{StaticResource SettingsSegmentBar}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SettingsFullscreenRadio" Content="{loc:T Fullscreen}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWindowMode"/>
                                    <RadioButton x:Name="SettingsWindowedRadio" Content="{loc:T Windowed}"
                                                 Style="{StaticResource SettingsSegment}" GroupName="QuickWindowMode"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{loc:T F11Hint}" FontSize="10.5"
                                       Foreground="{DynamicResource SettingsMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <Button x:Name="SettingsAdvancedButton" Content="{loc:T AdvancedSettings}"
                                    Margin="0,22,0,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SettingsPrimaryAction}"
                                    ToolTip="{loc:T AdvancedSettingsTooltip}"/>
                            <Button x:Name="SettingsExitButton" Content="{loc:T ExitGlowline}"
                                    Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SettingsAction}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock x:Name="HintText" Text="{loc:T HintFullscreen}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                       FontSize="11" Foreground="#59FFFFFF"/>
        </Grid>
    </Grid>
</Window>
