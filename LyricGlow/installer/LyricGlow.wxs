<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Glowline"
           Manufacturer="fSS"
           Version="$(var.Version)"
           UpgradeCode="5B8B9912-2B6E-4213-BC98-AE8340212364"
           Scope="$(var.Scope)"
           Compressed="yes"
           InstallerVersion="500"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Glowline is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.ProjectDir)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LyricGlow" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Directory Id="CommonDesktopFolder" />

    <Component Id="AppComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="LyricGlowExe"
            Source="$(var.PublishDir)\LyricGlow.exe"
            KeyPath="yes" />
      <Shortcut Id="StartMenuShortcut"
                Directory="ProgramMenuFolder"
                Name="Glowline"
                Description="Synced lyrics for Windows"
                Target="[INSTALLFOLDER]LyricGlow.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="Glowline"
                Description="Synced lyrics for Windows"
                Target="[INSTALLFOLDER]LyricGlow.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
    </Component>

    <Component Id="CommonDesktopComponent" Directory="CommonDesktopFolder" Guid="*" Condition="ALLUSERS = 1">
      <Shortcut Id="CommonDesktopShortcut"
                Directory="CommonDesktopFolder"
                Name="Glowline"
                Description="Synced lyrics for Windows"
                Target="[INSTALLFOLDER]LyricGlow.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RegistryValue Root="HKLM" Key="Software\LyricGlow" Name="CommonDesktopShortcut"
                     Value="1" Type="integer" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Glowline" Level="1">
      <ComponentRef Id="AppComponent" />
      <ComponentRef Id="CommonDesktopComponent" />
    </Feature>

    <Launch Condition="VersionNT64 AND VersionNT &gt;= 10" Message="Glowline requires Windows 10 or Windows 11, 64-bit." />
  </Package>
</Wix>
