                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MouseDoubleClick="SearchResults_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:T SearchHint}" Foreground="{DynamicResource Faint}"
                                       FontSize="11" Margin="26,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DesignerCard" Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="08" Style="{StaticResource SectionNumber}"/>
                                    <TextBlock Text="{loc:T Designer.Tab.Design}" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ActiveDesignText" Text="" Foreground="{DynamicResource Ink}"
                                       FontSize="13" Margin="26,14,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="26,14,0,0">
                                <Button Content="{loc:T ImportDesign}" Style="{StaticResource SmallButton}"
                                        Click="ImportDesign_Click"/>
                                <Button Content="{loc:T ExportDesign}" Style="{StaticResource SmallButton}"
                                        Margin="6,0,0,0" Click="ExportDesign_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SectionGeneral" Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="09" Style="{StaticResource SectionNumber}"/>
                                    <TextBlock Text="{loc:T General}" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="26,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T Language}" Foreground="{DynamicResource Muted}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="LanguageCombo_Changed"/>
                            </Grid>
                            <TextBlock Text="{loc:T LanguageHint}" Foreground="{DynamicResource Faint}"
                                       FontSize="11" Margin="26,6,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="CoverPaletteCheck" Content="{loc:T CoverPalette}"
                                      Margin="26,14,0,0" Checked="CoverPalette_Changed"
                                      Unchecked="CoverPalette_Changed"/>
                            <TextBlock Text="{loc:T CoverPaletteHint}" Foreground="{DynamicResource Faint}"
                                       FontSize="11" Margin="26,4,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="26,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T InterfaceTheme}" Foreground="{DynamicResource Muted}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentBar}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeLightRadio" Content="{loc:T ThemeLight}"
                                                     GroupName="InterfaceTheme" Style="{StaticResource SegmentRadio}"
                                                     Checked="InterfaceTheme_Changed"/>
                                        <RadioButton x:Name="ThemeDarkRadio" Content="{loc:T ThemeDark}"
                                                     GroupName="InterfaceTheme" Style="{StaticResource SegmentRadio}"
                                                     Checked="InterfaceTheme_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="InterfaceGlassCheck" Content="{loc:T InterfaceTranslucent}"
                                      Margin="26,14,0,0" Checked="InterfaceGlass_Changed"
                                      Unchecked="InterfaceGlass_Changed"/>
                            <TextBlock Text="{loc:T InterfaceTranslucentHint}" Foreground="{DynamicResource Faint}"
                                       FontSize="11" Margin="26,4,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="26,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T PreferredPlayer}" Foreground="{DynamicResource Muted}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PlayerCombo" Grid.Column="1" SelectionChanged="PlayerCombo_Changed"/>
                                <Button Style="{StaticResource GlyphButton}" Grid.Column="2"
                                        Margin="4,0,0,0" Click="RefreshPlayers_Click"
                                        ToolTip="{loc:T RefreshPlayersTooltip}">
                                    <Path Data="M 12,8 A 4,4 0 1 1 8,4 M 8,4 L 10.5,2 M 8,4 L 10.5,6"
                                          Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Fill="Transparent"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="StartWithWindowsCheck" Content="{loc:T StartWithWindows}"
                                      Margin="26,16,0,0" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                            <CheckBox x:Name="SoftwareRenderCheck" Content="{loc:T SoftwareRendering}"
                                      Margin="26,12,0,0" Checked="SoftwareRender_Changed" Unchecked="SoftwareRender_Changed"/>
                            <TextBlock Text="{loc:T SoftwareRenderingHint}" Foreground="{DynamicResource Faint}"
                                       FontSize="11" Margin="26,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SectionUpdates" Style="{StaticResource Section}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="10" Style="{StaticResource SectionNumber}"/>
                                    <TextBlock Text="{loc:T UpdatesTitle}" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="26,16,0,0">
                                <TextBlock x:Name="UpdateVersionText" Text="{loc:T CurrentVersionLabel}"
                                           Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                                <Button x:Name="UpdateCheckButton" Content="{loc:T CheckNow}"
                                        Style="{StaticResource SmallButton}" HorizontalAlignment="Right"
                                        Click="UpdateCheck_Click"/>
                            </Grid>
                            <CheckBox x:Name="AutoUpdateCheck" Content="{loc:T AutoUpdateCheckbox}"
                                      Margin="26,14,0,0" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
                            <Button x:Name="UpdateStarButton" Content="{loc:T StarOnGitHub}"
                                    Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                    Margin="26,12,0,0" Click="UpdateStar_Click"/>
                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource UpdateProgress}"
                                         Minimum="0" Maximum="100" Value="0" Margin="26,12,0,0"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText" Text="{loc:T UpdateNotChecked}"
                                       Foreground="{DynamicResource Faint}" FontSize="11" Margin="26,8,0,0"
                                       TextWrapping="Wrap"/>
                            <Border x:Name="UpdateNotesBorder" Margin="26,12,0,0" Padding="14,12"
                                    Background="{DynamicResource Hover}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="2" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateNotesTitle" Text=""
                                               Foreground="{DynamicResource Ink}" FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <ScrollViewer MaxHeight="190" Margin="0,8,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="UpdateNotesText" Text=""
                                                   Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                   LineHeight="17" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <Button x:Name="UpdateInstallButton" Content="{loc:T RestartAndInstall}"
                                    Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                    Margin="26,12,0,0" Visibility="Collapsed" Click="UpdateInstall_Click"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SectionDiagnostics" Style="{StaticResource Section}" BorderThickness="0,1,0,1">
                        <StackPanel>
                            <Expander x:Name="DiagExpander" Style="{StaticResource DiagExpanderStyle}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="11" Style="{StaticResource SectionNumber}"/>
                                        <TextBlock Text="{loc:T DiagnosticsTitle}" Style="{StaticResource SectionTitle}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBox x:Name="DiagBox" Height="190" IsReadOnly="True"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                             Background="{DynamicResource Canvas}" Foreground="{DynamicResource Muted}"
                                             BorderBrush="{DynamicResource Line}" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" Margin="26,10,0,0"/>
                                    <TextBlock x:Name="PathInfo" Foreground="{DynamicResource Faint}" FontSize="10"
                                               Margin="26,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
