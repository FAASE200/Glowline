                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="PrevButton" Style="{StaticResource GlyphButton}" Click="Prev_Click">
                                    <Path Data="M 4,4.4 L 6.4,4.4 L 6.4,19.6 L 4,19.6 Z M 19.6,4.4 L 7.8,12 L 19.6,19.6 Z"
